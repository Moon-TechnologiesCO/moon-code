/* Diseño de Moon Code. Los colores vienen del tema activo (moon-night / moon-light). */

Screen {
    background: $background;
}

#workspace {
    height: 1fr;
}

#explorer {
    width: 32;
    min-width: 20;
    background: $surface;
    border-right: tall $primary-darken-2;
    padding: 0 1;
}

#explorer:focus-within {
    border-right: tall $primary;
}

#tabs {
    width: 1fr;
}

#tabs > ContentSwitcher {
    height: 1fr;
}

TabPane {
    padding: 0;
}

#welcome {
    padding: 2 4;
    color: $foreground;
}

TextArea {
    height: 1fr;
}

#chat {
    width: 40%;
    min-width: 30;
    display: none;
    background: $surface;
    border-left: tall $secondary;
}

#chat-title {
    padding: 0 1;
    background: $panel;
    text-style: bold;
}

#chat-log {
    padding: 0 1;
}

.msg {
    margin: 1 0 0 0;
}

.reply {
    color: $accent;
}

#chat-input {
    dock: bottom;
}

Header {
    background: $panel;
}

Footer {
    background: $panel;
}
